#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="/var/www/html/virtual-otp-system"
CONFIG_FILE="$ROOT_DIR/.deploy-otp.env"
DOMAIN="otp.globalcareerhub.org"
DEPLOY_USER="${SUDO_USER:-${USER:-www-data}}"
ACTION="${1:-deploy}"
COMMIT_MESSAGE="${2:-Deploy production}"

red='\033[0;31m'; green='\033[0;32m'; yellow='\033[1;33m'; blue='\033[0;34m'; reset='\033[0m'
say() { printf '%b\n' "$1"; }
fail() { say "${red}ERROR: $1${reset}" >&2; exit 1; }
need() { command -v "$1" >/dev/null || fail "$1 is required. Install the VPS prerequisites first."; }
secret() { local value; read -r -s -p "$1: " value; printf '\n' >&2; printf '%s' "$value"; }

if [[ "$ACTION" == "--help" || "$ACTION" == "help" ]]; then
  cat <<'EOF'
Usage:
  deploy-otp        Pull latest main code and deploy production
  deploy-otp push   Commit local project changes, push main, then deploy
  deploy-otp help   Show this help
EOF
  exit 0
fi

[[ "$(id -u)" -ne 0 ]] || fail "Run as the SSH user, not with sudo. The command uses sudo when needed."
[[ -d "$ROOT_DIR/.git" ]] || fail "Project not found at $ROOT_DIR. Clone it first."
need git; need curl; need sudo
cd "$ROOT_DIR"

if [[ "$ACTION" == "push" ]]; then
  say "${blue}==> Committing and pushing new project code${reset}"
  git diff --check
  if [[ -n "$(git status --porcelain)" ]]; then
    git add -A
    git commit -m "$COMMIT_MESSAGE"
  else
    say "${green}==> No local changes to commit${reset}"
  fi
  git push origin main
elif [[ "$ACTION" != "deploy" ]]; then
  fail "Unknown command: $ACTION. Use deploy-otp, deploy-otp push, or deploy-otp help."
fi

if ! command -v python3 >/dev/null || ! command -v npm >/dev/null || \
   ! command -v psql >/dev/null || ! command -v nginx >/dev/null; then
  command -v apt-get >/dev/null || fail "Automatic package setup supports Debian/Ubuntu only."
  say "${yellow}==> Installing VPS runtime packages${reset}"
  sudo apt-get update
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y \
    git curl openssl python3 python3-venv python3-pip nodejs npm \
    nginx postgresql postgresql-contrib
fi
sudo systemctl enable --now postgresql.service nginx.service

if [[ ! -f "$CONFIG_FILE" ]]; then
  say "${blue}==> First production setup${reset}"
  read -r -p "Domain [$DOMAIN]: " input_domain
  DOMAIN="${input_domain:-$DOMAIN}"
  [[ "$DOMAIN" =~ ^[A-Za-z0-9.-]+$ ]] || fail "Invalid domain."
  read -r -p "PostgreSQL database user [otpuser]: " DB_USER
  DB_USER="${DB_USER:-otpuser}"
  read -r -p "PostgreSQL database name [virtual_otp]: " DB_NAME
  DB_NAME="${DB_NAME:-virtual_otp}"
  [[ "$DB_USER" =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ && "$DB_NAME" =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]] || fail "Invalid PostgreSQL name."
  DB_PASSWORD="$(secret 'PostgreSQL password')"
  [[ ${#DB_PASSWORD} -ge 12 ]] || fail "PostgreSQL password must be at least 12 characters."
  FIVESIM_API_KEY="$(secret '5sim API key')"
  [[ -n "$FIVESIM_API_KEY" ]] || fail "5sim API key is required."
  read -r -p "Admin username [admin]: " ADMIN_USERNAME
  ADMIN_USERNAME="${ADMIN_USERNAME:-admin}"
  read -r -p "Admin email [admin@$DOMAIN]: " ADMIN_EMAIL
  ADMIN_EMAIL="${ADMIN_EMAIL:-admin@$DOMAIN}"
  ADMIN_PASSWORD="$(secret 'Admin password')"
  [[ ${#ADMIN_PASSWORD} -ge 8 ]] || fail "Admin password must be at least 8 characters."
  SECRET_KEY="$(openssl rand -hex 32 2>/dev/null || python3 -c 'import secrets; print(secrets.token_hex(32))')"
  CORS_ORIGINS="https://$DOMAIN,https://www.$DOMAIN"
  sudo -u postgres psql -v ON_ERROR_STOP=1 --dbname postgres \
    -v db_user="$DB_USER" -v db_password="$DB_PASSWORD" -v db_name="$DB_NAME" <<'SQL'
DO $$
BEGIN
  IF NOT EXISTS (SELECT FROM pg_catalog.pg_roles WHERE rolname = :'db_user') THEN
    EXECUTE format('CREATE ROLE %I LOGIN PASSWORD %L', :'db_user', :'db_password');
  ELSE
    EXECUTE format('ALTER ROLE %I LOGIN PASSWORD %L', :'db_user', :'db_password');
  END IF;
END
$$;
SQL
  sudo -u postgres psql -v ON_ERROR_STOP=1 --dbname postgres \
    -v db_user="$DB_USER" -v db_name="$DB_NAME" \
    -c "SELECT format('CREATE DATABASE %I OWNER %I', :'db_name', :'db_user') WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = :'db_name') \gexec"
  DATABASE_URL="postgresql://$DB_USER:$DB_PASSWORD@127.0.0.1:5432/$DB_NAME"
  umask 077
  cat > "$CONFIG_FILE" <<EOF
DOMAIN=$DOMAIN
DB_USER=$DB_USER
DB_NAME=$DB_NAME
DB_PASSWORD=$DB_PASSWORD
DATABASE_URL=$DATABASE_URL
FIVESIM_API_KEY=$FIVESIM_API_KEY
ADMIN_USERNAME=$ADMIN_USERNAME
ADMIN_EMAIL=$ADMIN_EMAIL
ADMIN_PASSWORD=$ADMIN_PASSWORD
SECRET_KEY=$SECRET_KEY
CORS_ORIGINS=$CORS_ORIGINS
EOF
  chmod 600 "$CONFIG_FILE"
  say "${green}==> Database and secure deployment settings created${reset}"
else
  # shellcheck disable=SC1090
  source "$CONFIG_FILE"
fi

[[ -n "${DATABASE_URL:-}" && -n "${FIVESIM_API_KEY:-}" ]] || fail "Deployment configuration is incomplete. Remove $CONFIG_FILE and rerun setup."
need python3; need npm; need psql

say "${yellow}==> Pulling latest production code${reset}"
git fetch origin main
git checkout main
git reset --hard origin/main

say "${yellow}==> Writing production environment files${reset}"
umask 077
cat > backend/.env <<EOF
DATABASE_URL=$DATABASE_URL
SECRET_KEY=$SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FIVESIM_API_KEY=$FIVESIM_API_KEY
DEFAULT_MARKUP_PERCENT=50
ADMIN_USERNAME=$ADMIN_USERNAME
ADMIN_EMAIL=$ADMIN_EMAIL
ADMIN_PASSWORD=$ADMIN_PASSWORD
CORS_ORIGINS=$CORS_ORIGINS
EOF
cat > frontend/.env.production <<EOF
NEXT_PUBLIC_API_URL=https://$DOMAIN
EOF

say "${yellow}==> Installing backend and frontend dependencies${reset}"
python3 -m venv backend/venv 2>/dev/null || true
backend/venv/bin/python -m pip install --upgrade pip -q
backend/venv/bin/pip install -r backend/requirements.txt
say "${yellow}==> Updating database schema and seed data${reset}"
(cd backend && venv/bin/python -c 'from app.database import Base, engine; from app.seed import seed_database; Base.metadata.create_all(bind=engine); seed_database()')
cd frontend
if [[ -f package-lock.json ]]; then npm ci; else npm install; fi
npm run build
cd "$ROOT_DIR"

sudo chown -R "$DEPLOY_USER":"$DEPLOY_USER" "$ROOT_DIR"
sudo tee /etc/systemd/system/otp-backend.service >/dev/null <<EOF
[Unit]
Description=Virtual OTP Backend
After=network.target postgresql.service
[Service]
User=$DEPLOY_USER
WorkingDirectory=$ROOT_DIR/backend
Environment=PATH=$ROOT_DIR/backend/venv/bin
ExecStart=$ROOT_DIR/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
EOF
sudo tee /etc/systemd/system/otp-frontend.service >/dev/null <<EOF
[Unit]
Description=Virtual OTP Frontend
After=network.target otp-backend.service
[Service]
User=$DEPLOY_USER
WorkingDirectory=$ROOT_DIR/frontend
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
EOF

if [[ ! -f /etc/nginx/sites-available/virtual-otp ]]; then
say "${yellow}==> Creating Nginx configuration${reset}"
sudo tee /etc/nginx/sites-available/virtual-otp >/dev/null <<EOF
upstream otp_api { server 127.0.0.1:8000; }
upstream otp_web { server 127.0.0.1:3000; }
server {
    listen 80;
    listen [::]:80;
    server_name $DOMAIN www.$DOMAIN;
    client_max_body_size 10M;
    location /api/ { proxy_pass http://otp_api; proxy_set_header Host \$host; proxy_set_header X-Forwarded-Proto \$scheme; proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for; proxy_read_timeout 120s; }
    location / { proxy_pass http://otp_web; proxy_http_version 1.1; proxy_set_header Upgrade \$http_upgrade; proxy_set_header Connection "upgrade"; proxy_set_header Host \$host; proxy_set_header X-Forwarded-Proto \$scheme; }
}
EOF
else
  say "${green}==> Keeping existing Nginx/HTTPS configuration${reset}"
fi
sudo ln -sfn /etc/nginx/sites-available/virtual-otp /etc/nginx/sites-enabled/virtual-otp
sudo nginx -t
sudo systemctl daemon-reload
sudo systemctl enable --now otp-backend.service otp-frontend.service
sudo systemctl restart otp-backend.service otp-frontend.service
sudo systemctl is-active --quiet otp-backend.service || fail "Backend failed; run journalctl -u otp-backend -n 50."
sudo systemctl is-active --quiet otp-frontend.service || fail "Frontend failed; run journalctl -u otp-frontend -n 50."
curl --fail --silent --show-error http://127.0.0.1:8000/health >/dev/null
curl --fail --silent --show-error http://127.0.0.1:3000/ >/dev/null
sudo systemctl reload nginx
say "${green}==> OTP production is ready: https://$DOMAIN${reset}"