# ====================== DATABASE ======================
DATABASE_URL=sqlite:///./virtual_otp.db

# ====================== SECURITY ======================
SECRET_KEY=change_this_to_a_very_long_random_secret_key_at_least_64_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ====================== 5SIM ======================
FIVESIM_API_KEY=your_5sim_api_key_here

# ====================== PRICING ======================
DEFAULT_MARKUP_PERCENT=50

# ====================== ADMIN SEED (first run) ======================
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@Secure123!

# ====================== CORS / SITE ======================
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SITE_URL=https://otp.globalcareerhub.org

# ====================== SMTP (password reset emails) ======================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=Virtual OTP <you@gmail.com>
