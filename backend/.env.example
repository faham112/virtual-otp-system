# ====================== DATABASE ======================
# Local SQLite (easiest for testing - no MySQL needed):
# DATABASE_URL=sqlite:///./virtual_otp.db

# MySQL / Hostinger:
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/virtual_otp

DATABASE_URL=sqlite:///./virtual_otp.db

# ====================== SECURITY ======================
SECRET_KEY=change_this_to_a_very_long_random_secret_key_at_least_64_chars_please_use_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ====================== 5SIM ======================
FIVESIM_API_KEY=your_5sim_api_key_here

# ====================== PRICING ======================
DEFAULT_MARKUP_PERCENT=50

# ====================== ADMIN SEED (created on first run) ======================
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@Secure123!

# ====================== CORS (comma separated, no spaces) ======================
# Local:
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production example:
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
