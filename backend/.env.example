# ====================== DATABASE ======================
# Local SQLite (easiest):
# DATABASE_URL=sqlite:///./virtual_otp.db

# Local / Hostinger MySQL:
# DATABASE_URL=mysql+pymysql://user:pass@localhost:3306/virtual_otp

# PostgreSQL (Railway / Production):
# DATABASE_URL=postgresql://user:pass@host:5432/railway
# On Railway use reference: ${{Postgres.DATABASE_URL}}

DATABASE_URL=sqlite:///./virtual_otp.db

# ====================== SECURITY ======================
SECRET_KEY=change_this_to_a_very_long_random_secret_key_at_least_64_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ====================== 5SIM ======================
FIVESIM_API_KEY=your_5sim_api_key_here

# ====================== PRICING ======================
DEFAULT_MARKUP_PERCENT=50

# ====================== ADMIN SEED (first run) ======================
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@Secure123!

# ====================== CORS ======================
# Local:
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Railway production (replace with real frontend domain):
# CORS_ORIGINS=https://your-frontend.up.railway.app
